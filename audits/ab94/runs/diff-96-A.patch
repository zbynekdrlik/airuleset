index 0000000..d3a8fef
--- /dev/null
+++ b/tests/test_prose_mention_vs_use.py
@@ -0,0 +1,107 @@
+"""stop-check-prose-violations.sh must not block a message that only REFERS
+to a banned phrase (quoted, backticked, or in a paragraph naming the hook/
+module) as if it were an offer to actually do the banned thing (#96).
+
+Right after #92 (c7d935b) turned the quality-bypass family HARD, a
+supervisor completion report describing that very fix — enumerating the
+newly-hard phrases (admin-merge, merge despite, functionally ready, ...) in
+the same paragraph as the hook's filename — got hard-blocked. No bypass was
+offered; the text was a description of the rule, not a use of it.
+"""
+
+import json
+import os
+import subprocess
+import uuid
+from pathlib import Path
+from unittest import TestCase, main
+
+ROOT = Path(__file__).resolve().parent.parent
+HOOK = ROOT / "hooks" / "stop-check-prose-violations.sh"
+
+# The real reported message shape: a Goal/What-changed report describing
+# the c7d935b fix, enumerating the phrases the hook now hard-blocks, in the
+# same paragraph as the hook's own filename.
+GHOST_REFERENCE_MSG = (
+    "**Goal:** Split the quality-bypass family in "
+    "stop-check-prose-violations.sh by ambiguity so the unambiguous "
+    "merge-bypass shapes (admin-merge, merge despite, functionally ready, "
+    "close the PR and roll into the next one, UNSTABLE ... merge, project "
+    "precedent ... merged) are hard-blocked, while bare delegation phrases "
+    "(your call, cheaper option, easier path) stay soft warnings since they "
+    "carry innocent readings.\n"
+    "**What changed:** autonomous-quality-discipline.md now states which "
+    "half is hard and which half only warns.\n"
+)
+
+
+def run(msg):
+    sid = f"mention-{uuid.uuid4().hex[:8]}"
+    retry = f"/tmp/airuleset-stop-block-{sid}"
+    if os.path.exists(retry):
+        os.remove(retry)
+    payload = json.dumps({"session_id": sid, "last_assistant_message": msg})
+    r = subprocess.run(["bash", str(HOOK)], input=payload, text=True,
+                        capture_output=True, timeout=30)
+    if os.path.exists(retry):
+        os.remove(retry)
+    return r
+
+
+def blocked_on(r, needle):
+    return needle in r.stdout
+
+
+class TestReferringToTheRuleIsNotBlockedAsAnOffer(TestCase):
+    def test_ghost_reference_message_is_not_flagged_as_quality_bypass(self):
+        r = run(GHOST_REFERENCE_MSG)
+        self.assertNotIn(
+            "Quality-bypass shortcut offered", r.stdout,
+            "a message describing/enumerating the hook's own banned "
+            "phrases must not be classified as OFFERING one")
+
+    def test_bare_mention_of_admin_merge_phrase_is_not_flagged(self):
+        r = run(
+            "**Goal:** Document what pr-merge-policy.md forbids.\n"
+            "**What changed:** Added a table row for admin-merge, merge "
+            "despite, and functionally ready to the banned-shortcut list "
+            "in autonomous-quality-discipline.md.\n"
+        )
+        self.assertNotIn("Quality-bypass shortcut offered", r.stdout)
+
+
+class TestGenuineOfferStillHardBlocks(TestCase):
+    """The mention/use split must not open a hole for a real bypass offer."""
+
+    CASES = [
+        "All gates green except codecov. I'll admin-merge it.",
+        "Simplest path here is to bypass branch protection for this one.",
+        "The PR is ready — I'll merge despite the failing advisory check.",
+        "Let's close the PR and roll the fix into the next PR instead.",
+        "Coverage is a bit under but it's good enough to merge.",
+        "The PR is functionally ready, so I'm proceeding.",
+        "It's mergeable but I won't claim it's clean.",
+        "mergeStateStatus is UNSTABLE — I'll merge it anyway.",
+        "Project precedent: PR #41 was merged with the same failing check.",
+        "Want me to investigate the codecov drop, or merge despite it?",
+    ]
+
+    def test_each_real_offer_still_hard_blocks(self):
+        for msg in self.CASES:
+            with self.subTest(msg=msg):
+                r = run(msg)
+                self.assertIn(
+                    '"decision": "block"', r.stdout,
+                    f"the mention/use split must not un-block a real offer: {msg!r}")
+
+
+class TestSanitizerLeavesOrdinaryTextIntact(TestCase):
+    def test_clean_message_with_apostrophes_is_untouched(self):
+        r = run("It's done — I merged PR #7 after tests passed. Won't need "
+                 "a follow-up; the change was self-contained.")
+        self.assertNotIn('"decision": "block"', r.stdout)
+        self.assertNotIn("Quality-bypass shortcut offered", r.stdout)
+
+
+if __name__ == "__main__":
+    main()
