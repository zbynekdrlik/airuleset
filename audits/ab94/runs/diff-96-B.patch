@@ -0,0 +1,97 @@
+"""Use vs mention: the Stop gate must not block a message that only REFERS to
+a banned phrase (#96 — third instance of the #80/#91 class).
+
+Right after #92 hard-blocked the quality-bypass family, the Stop gate blocked
+a supervisor message that only enumerated the newly-banned shapes from an
+overview of what the hook now catches — a description, not an offer. Same
+root cause as #80 (heredoc body misread as a command) and #91 (an injection
+hook fired on its own comment merely describing a trigger table): the
+classifier could not distinguish USE from MENTION.
+
+Real corpus replay (4424 historical assistant messages pulled from this
+repo's own session transcripts) found 38/91 pre-fix hard blocks were exactly
+this false-positive shape — a completion report or supervisor message
+quoting/describing what `stop-check-prose-violations.sh` blocks — and zero
+genuine bypass/pre-answered-question offers among them.
+"""
+
+import json
+import os
+import subprocess
+import uuid
+from pathlib import Path
+from unittest import TestCase, main
+
+ROOT = Path(__file__).resolve().parent.parent
+HOOK = ROOT / "hooks" / "stop-check-prose-violations.sh"
+
+
+def run(msg):
+    sid = f"mention-{uuid.uuid4().hex[:8]}"
+    retry = f"/tmp/airuleset-stop-block-{sid}"
+    if os.path.exists(retry):
+        os.remove(retry)
+    payload = json.dumps({"session_id": sid, "last_assistant_message": msg})
+    r = subprocess.run(["bash", str(HOOK)], input=payload, text=True,
+                       capture_output=True, timeout=30)
+    if os.path.exists(retry):
+        os.remove(retry)
+    return r
+
+
+def blocked(r):
+    return '"decision": "block"' in r.stdout or '"decision":"block"' in r.stdout
+
+
+class TestMentionOfBannedPhraseIsNotBlocked(TestCase):
+    """The literal live incident: a message REFERRING to the rule change."""
+
+    def test_completion_report_describing_c7d935b_change_is_not_blocked(self):
+        msg = (
+            "Verified from primary sources: RED→GREEN chain `321faf5`…"
+            "`3d670ac` intact, tree clean, #92 / #93 / #39 all CLOSED, "
+            "23 open remaining. The gate claim checks out too — `add_hard` "
+            "now fires 17× in `stop-check-prose-violations.sh`, "
+            "`admin-merge` is matched twice, and "
+            "`tests/test_quality_bypass_gate.py` exists with its RED "
+            "`c53c59a` → GREEN `c7d935b` pair.\n\n"
+            "The worker's question is already answered by the rule it just "
+            "edited — `autonomous-quality-discipline.md` documents the "
+            "split deliberately (\"each has an innocent reading the gate "
+            "must not gate\"). Keeping the ambiguous phrases as warn-only; "
+            "no user decision needed."
+        )
+        r = run(msg)
+        self.assertFalse(blocked(r), f"a description of the rule must not block\n{r.stdout}")
+
+    def test_supervisor_overview_of_banned_shapes_is_not_blocked(self):
+        msg = (
+            "Audit note: `stop-check-prose-violations.sh` splits this family "
+            "by ambiguity (verified per phrase, #92): the UNAMBIGUOUS bypass "
+            "shapes — admin-merge, bypass branch protection, "
+            "\"merge despite …\" — are HARD-blocked at Stop. The bare "
+            "delegation phrases only WARN and are never blocked."
+        )
+        r = run(msg)
+        self.assertFalse(blocked(r), f"an audit note citing the hook must not block\n{r.stdout}")
+
+
+class TestGenuineOfferStillBlocks(TestCase):
+    """The fix must not open a hole: a real bare offer still hard-blocks."""
+
+    CASES = [
+        "All gates green except codecov. I'll admin-merge it.",
+        "Simplest path here is to bypass branch protection for this one.",
+        "The PR is ready — I'll merge despite the failing advisory check.",
+        "The PR is functionally ready, so I'm proceeding.",
+    ]
+
+    def test_each_bare_offer_still_blocks(self):
+        for msg in self.CASES:
+            with self.subTest(msg=msg):
+                r = run(msg)
+                self.assertTrue(blocked(r), f"must still HARD-block: {msg!r}\n{r.stdout}")
+
+
+if __name__ == "__main__":
+    main()
