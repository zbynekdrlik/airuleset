+class CommandSubstitution88(unittest.TestCase):
+    """#88, found replaying gk's real corpus (1/687, 0.15%): the classifier
+    segments on raw statement/pipe separators (`;`, `&&`, `||`, `&`, a real
+    newline) with NO notion of `$( … )` / `` ` … ` `` boundaries at all — a
+    health-check one-liner whose STATUS STRING embeds a `;`/newline INSIDE a
+    command substitution (`$(curl -s "$u" -m 15; grep -oP '...' /tmp/f)`,
+    the shape gk's real liveness/version probe used) gets segmented as if
+    that `;`/newline were a genuine top-level statement boundary — the
+    inner `grep` then IS its own "statement" and blocks, even though the
+    outer shape is a single cheap echo/printf line producing a small status
+    string (never the context cost this hook guards).
+
+    Fixed the same way #80 fixed heredoc bodies: substitution content is
+    payload to the outer command, not a statement of its own, and is
+    stripped before segmentation."""
+
+    def _armed(self, command, **kw):
+        helper = MainImplementationGuard()
+        return helper._run(tool="Bash", command=command,
+                           transcript_text=goal_armed_transcript(), **kw)
+
+    def test_health_check_semicolon_inside_dollar_paren_allowed(self):
+        # RED without the fix: `;` inside $( … ) is read as a genuine
+        # statement separator, and the `grep` after it blocks on its own.
+        out = self._armed(
+            'echo "version: $(curl -s https://erp.montalu.sk/web/health '
+            '-m 15; grep -oP \'(?<=.version.: .)[0-9.]+\' /tmp/last.json)"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_health_check_loop_with_semicolon_reducer_allowed(self):
+        # the fuller multi-line health-check shape from the real gk incident
+        out = self._armed(
+            'echo "=== liveness ==="\n'
+            'for u in https://erp.montalu.sk/web/health https://erp.montalu.sk; do\n'
+            '  printf "%s -> %s\\n" "$u" "$(curl -s -o /dev/null -w '
+            "'%{http_code}' -m 15 \"$u\")\"\n"
+            'done\n'
+            'echo "version: $(curl -s https://erp.montalu.sk/web/health '
+            '-m 15; grep -oP \'(?<=.version.: .)[0-9.]+\' /tmp/last.json)"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_newline_inside_dollar_paren_allowed(self):
+        # RED without the fix: a literal newline inside $( … ) (a script
+        # written multi-line for readability) is read the same way as a `;`
+        out = self._armed(
+            'echo "n=$(curl -s https://erp.montalu.sk/web/health\n'
+            "grep -oP '[0-9.]+' /tmp/last.json)\"")
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_backtick_substitution_with_semicolon_reducer_allowed(self):
+        out = self._armed(
+            'echo "n=`curl -s https://erp.montalu.sk/web/health -m 15; '
+            'grep -oP \'[0-9.]+\' /tmp/last.json`"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_bulk_read_outside_the_substitution_still_blocks(self):
+        # stripping the substitution's CONTENT must not swallow a genuine
+        # bulk read sitting in a SIBLING statement outside it
+        out = self._armed(
+            'echo "v=$(curl -s "$u" -m 15; grep -oP \'[0-9.]+\' /tmp/f)"\n'
+            'cat /etc/passwd')
+        self.assertEqual(out.returncode, 2, out.stdout + out.stderr)
+
+    def test_bare_dollar_paren_curl_untouched(self):
+        # the common non-piped shape ($(...) with no inner separator at
+        # all) must keep working exactly as before
+        out = self._armed(
+            'printf "%s -> %s\\n" "$u" "$(curl -s -o /dev/null -w '
+            "'%{http_code}' -m 15 \"$u\")\"")
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+
