+# #88: strip `$( … )` / `` ` … ` `` command-substitution CONTENT before
+# segmentation, same shape/rationale as the heredoc-body strip above — it is
+# PAYLOAD to the OUTER command (a cheap one-line status string), not a
+# statement of its own. Found replaying gk's real corpus (#80's method): a
+# health-check one-liner with `$(curl -s "$u" -m 15; grep -oP '...' /tmp/f)`
+# (or the same thing written across a real newline) has a `;`/newline INSIDE
+# the substitution — the classifier only ever segments on RAW statement
+# separators (`;`, `&&`, `||`, `&`, a literal newline), with no notion of
+# `$( … )` boundaries at all, so that inner `grep` gets read as its OWN
+# top-level statement and blocks a call whose OUTER shape is a single cheap
+# echo/printf line (1/687 in the replayed corpus, 0.15%). Losing the ability
+# to classify a genuine BULK read hidden INSIDE a substitution is the same
+# accepted trade-off #80 already made for heredoc bodies — a false positive
+# is what disabled the whole guard for 17 hours in #80's OWN incident, so
+# this class of hole gets closed on sight rather than left for a repeat.
+# `$( … )` is expansion-active even inside a double-quoted string (only
+# single quotes suppress it in real bash), so this is tracked char-by-char
+# rather than delegated to shlex, which has no idea `$(...)` is not just
+# more quoted text.
+
+
+def _skip_balanced_parens(text, i, n):
+    # `i` sits just past the opening `$(` — return the index just past its
+    # matching close paren. Tracks nested parens/quotes so an inner `$(...)`,
+    # a `)` inside a string literal, or an escaped char never closes it early.
+    depth = 1
+    in_sq = in_dq = False
+    while i < n and depth > 0:
+        c = text[i]
+        if in_sq:
+            if c == "'":
+                in_sq = False
+        elif in_dq:
+            if c == "\\" and i + 1 < n:
+                i += 1
+            elif c == '"':
+                in_dq = False
+        else:
+            if c == "'":
+                in_sq = True
+            elif c == '"':
+                in_dq = True
+            elif c == "\\" and i + 1 < n:
+                i += 1
+            elif c == "(":
+                depth += 1
+            elif c == ")":
+                depth -= 1
+        i += 1
+    return i
+
+
+def strip_command_substitutions(text):
+    out = []
+    i, n = 0, len(text)
+    in_sq = False
+    while i < n:
+        c = text[i]
+        if in_sq:
+            out.append(c)
+            if c == "'":
+                in_sq = False
+            i += 1
+            continue
+        if c == "'":
+            in_sq = True
+            out.append(c)
+            i += 1
+            continue
+        if c == "\\" and i + 1 < n:
+            out.append(c)
+            out.append(text[i + 1])
+            i += 2
+            continue
+        if c == "$" and i + 1 < n and text[i + 1] == "(":
+            i = _skip_balanced_parens(text, i + 2, n)
+            continue
+        if c == "`":
+            j = i + 1
+            while j < n and text[j] != "`":
+                if text[j] == "\\" and j + 1 < n:
+                    j += 2
+                    continue
+                j += 1
+            i = j + 1 if j < n else j
+            continue
+        out.append(c)
+        i += 1
+    return "".join(out)
+
+
+cmd = strip_command_substitutions(cmd)
+
