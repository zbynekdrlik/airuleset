+# Diff base: prefer the merge-base with THIS branch's own upstream tracking
+# branch over the hardcoded default-branch guess (#86). The default-branch
+# guess is correct only for a 2-branch (dev/main) model — in a 3-branch
+# model (develop -> staging -> main) a develop-target push was diffed
+# against a REAL but STALE origin/main, attributing every sanctioned
+# skip-shaped test change already on develop since the last release to
+# THIS push (live repro: zbynekdrlik/odoo-erp, its own #2206 exception).
+# Falls back to the default-branch guess when there's no upstream (e.g. a
+# brand-new branch never pushed), and to HEAD~1 when neither resolves.
+UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "")
+BASE=""
+if [ -n "$UPSTREAM" ]; then
+    BASE=$(git merge-base HEAD "$UPSTREAM" 2>/dev/null || echo "")
+fi
+[ -z "$BASE" ] && BASE="origin/${DEFAULT_BRANCH}"
+
 AUDIT_LOG="$HOME/devel/airuleset/audits/test-skip-bypasses.log"
 mkdir -p "$(dirname "$AUDIT_LOG")"
 
