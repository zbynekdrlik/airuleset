+    # --- 3-branch model false-block (#86, live repro: zbynekdrlik/odoo-erp) -
+
+    def _repo_develop_tracking(self, stale_skip_content, new_added_content):
+        """3-branch model repro (#86, live: zbynekdrlik/odoo-erp
+        develop -> staging -> main). The work branch `develop` tracks
+        `origin/develop`; `origin/main` is REAL but STALE — it points at
+        the last release, well behind develop. `stale_skip_content` is
+        sanctioned skip-shaped test content that landed on develop AFTER
+        that release (e.g. odoo-erp's own #2206 E2E exception) — it is
+        already on origin/develop, so it must NOT be attributed to a later
+        push that only adds unrelated content. `new_added_content` is what
+        THIS push adds. `origin/HEAD` is deliberately left unset (a normal
+        checkout has no symbolic-ref for it), so the old default-branch
+        guess falls back to the hardcoded "main" — which DOES exist here,
+        unlike a simpler repro, reproducing the real false-block."""
+        import shutil
+        root = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, root, ignore_errors=True)
+
+        def g(*a):
+            return subprocess.run(["git", *a], cwd=root, capture_output=True, text=True)
+        g("init", "-q", "-b", "develop")
+        g("config", "user.email", "t@t")
+        g("config", "user.name", "t")
+        test_path = os.path.join(root, "tests", "test_thing.py")
+        os.makedirs(os.path.dirname(test_path), exist_ok=True)
+        # commit A: last release state, becomes the stale origin/main
+        with open(test_path, "w") as fh:
+            fh.write("")
+        g("add", "tests/test_thing.py")
+        g("commit", "-qm", "release base")
+        release_sha = g("rev-parse", "HEAD").stdout.strip()
+        g("update-ref", "refs/remotes/origin/main", release_sha)
+        # commit B: sanctioned skip landed on develop since the release,
+        # already pushed — becomes origin/develop (this push's real base)
+        with open(test_path, "a") as fh:
+            fh.write(stale_skip_content)
+        g("add", "tests/test_thing.py")
+        g("commit", "-qm", "chore: sanctioned e2e skip exception")
+        develop_sha = g("rev-parse", "HEAD").stdout.strip()
+        g("update-ref", "refs/remotes/origin/develop", develop_sha)
+        # a bare branch.*.remote/.merge config is NOT enough for `@{u}` to
+        # resolve — git also needs a real `remote.origin.*` fetch refspec
+        # to map refs/heads/develop (remote-side) to the local
+        # remote-tracking ref; the URL itself is never dereferenced here.
+        g("remote", "add", "origin", "file:///nonexistent-origin")
+        g("config", "branch.develop.remote", "origin")
+        g("config", "branch.develop.merge", "refs/heads/develop")
+        # commit C: THIS push's actual new content, on top of develop's tip
+        with open(test_path, "a") as fh:
+            fh.write(new_added_content)
+        g("add", "tests/test_thing.py")
+        g("commit", "-qm", "test: add coverage on develop")
+        return root
+
+    def test_three_branch_model_does_not_falsely_block_on_stale_develop_skip(self):
+        # This push only adds an unrelated real test on top of develop's
+        # tip. The old default-branch guess diffed against the REAL but
+        # STALE origin/main instead of develop's own upstream, attributing
+        # the sanctioned skip that already landed on develop (since the
+        # last release) to THIS push, and false-blocked on it.
+        base = "test.skip('sanctioned e2e exception', () => { expect(1).toBe(1); });\n"
+        root = self._repo_develop_tracking(base, "def test_new_real():\n    assert 2 + 2 == 4\n")
+        r = self._run("git push origin develop", root)
+        self.assertEqual(r.returncode, 0, r.stdout)
+
+    def test_three_branch_model_still_blocks_genuine_new_violation(self):
+        # sanity check for the fix above: a REAL new skip added on develop
+        # must still be caught, even though the diff base is no longer
+        # origin/main.
+        root = self._repo_develop_tracking("", "test.skip('lazy', () => { expect(1).toBe(1); });\n")
+        r = self._run("git push origin develop", root)
+        self.assertEqual(r.returncode, 2, r.stdout)
+        self.assertIn("test.skip", r.stdout)
+
 
