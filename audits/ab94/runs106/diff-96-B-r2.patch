+# MSG_STRIP / MSG_NOGOAL_STRIP: the prose-violation phrase checks below hunt
+# banned SHAPES ("admin-merge", "please test it", "your call", ...) meant to
+# catch the model OFFERING one of them. They don't distinguish that from a
+# message that only REFERS to the rule — e.g. a status update enumerating
+# what this very hook blocks, in backticks per this repo's own convention
+# (`admin-merge`, `merge despite <x>` — see tests/test_quality_bypass_gate.py).
+# #92's hard-block landed and immediately caught exactly that shape (#96): a
+# supervisor report describing the new gate, not offering a bypass.
+#
+# An inline backtick span alone is NOT a safe strip signal: an actual offer is
+# routinely code-formatted too ("I'll run `gh pr merge --admin`" is a real
+# offer, not a citation — verified live, this would otherwise open exactly the
+# hole #96 says GREEN must not open). The real distinguishing signal is
+# per-SENTENCE: a sentence carrying a first-person commitment cue ("I'll",
+# "I will", "I'm going to", "let's") is the model talking to the user — leave
+# it untouched, backticks and all. A sentence with no such cue is safe to
+# strip citations from before phrase-matching. Split on sentence-ish
+# boundaries (.!?  or newline), classify each unit on its OWN text with
+# citations already removed (so a cue INSIDE the backticks, i.e. quoted as
+# part of the banned example, doesn't count), and keep the unit's ORIGINAL
+# text whenever the cue is present outside any span.
+# Only inline `...` spans are stripped (length-capped so an unbalanced single
+# backtick can't gobble the rest of the message) — NOT triple-fenced blocks,
+# which stay untouched everywhere (the ASCII-art/box-drawing check relies on
+# real box-drawing content living inside a fence on purpose; blindly
+# defencing would blind that check too).
+# NOT applied to: the ASCII-art/box-drawing check itself, or any structural
+# completion-report detector (heading/PR-URL/Goal/Outcome/audit-line
+# presence) — those aren't banned rhetorical phrases, they're document-shape
+# checks.
+strip_mentions() {
+    python3 - "$1" <<'PYEOF'
+import re, sys
+
+CUE = re.compile(r"\bI'?ll\b|\bI will\b|\bI'?m going to\b|\bI am going to\b|\blet'?s\b", re.I)
+SPAN = re.compile(r"`[^`\n]{1,300}`")
+
+t = sys.argv[1]
+
+# Stash backtick spans BEFORE sentence-splitting: a span's own content can
+# contain '.'/'?'/'!' (e.g. the literal "UNSTABLE ... merge" ellipsis in this
+# repo's own banned-shape examples) — splitting first would slice a span in
+# half and desync open/close backticks across two "sentence" units.
+spans = []
+
+def stash(m):
+    spans.append(m.group(0))
+    return f"\x00{len(spans) - 1}\x00"
+
+placeholder_text = SPAN.sub(stash, t)
+
+parts = re.split(r'([.!?\n]+\s*)', placeholder_text)
+out = []
+i = 0
+while i < len(parts):
+    unit = parts[i]
+    sep = parts[i + 1] if i + 1 < len(parts) else ""
+    has_cue = bool(CUE.search(unit))
+    unit = re.sub(r'\x00(\d+)\x00', lambda m: spans[int(m.group(1))] if has_cue else " ", unit)
+    out.append(unit)
+    out.append(sep)
+    i += 2
+sys.stdout.write("".join(out))
+PYEOF
+}
+MSG_STRIP=$(strip_mentions "$MSG")
+MSG_NOGOAL_STRIP=$(strip_mentions "$MSG_NOGOAL")
+
