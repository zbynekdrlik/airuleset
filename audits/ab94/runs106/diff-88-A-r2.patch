+class CommandSubstitutionOpacity88(unittest.TestCase):
+    """#88, found replaying the corpus from #80 (1 of 687 real gk commands):
+    STATEMENTS_RE splits on `;`/`&`/`&&`/`||`/newline WITHOUT being aware of
+    `$( ... )` / backtick command-substitution boundaries. When the
+    substitution's OWN inner text contains one of those separators, the part
+    after it (often a `grep`/`awk`/`cat` reducer feeding a cheap one-line
+    printf/echo) gets sliced off and classified as if it were a fresh
+    TOP-LEVEL statement — and blocked — even though the whole visible output
+    of the outer command is a single short line (a health-check status, a
+    version string). Real gk shape:
+
+        printf "%s -> %s\\n" "$u" "$(curl -s -m 15 "$u")"
+        echo "verzia: $(command -v jq && grep -oP '(?<=version: )\\S+' f)"
+
+    Fix: strip the CONTENTS of every `$( ... )` / `` ` ... ` `` span (quote-
+    and nesting-aware) to an opaque placeholder BEFORE segmentation — the
+    same treatment heredoc BODIES already get (#80) — so an operator hidden
+    inside a substitution can never split the outer command into extra
+    statements. A substitution that is itself a genuine standalone bulk read
+    (`X=$(cat bigfile)`) is deliberately left unclassified: the corpus
+    showed this shape only in cheap-output contexts (1/687), and the
+    non-negotiable CI-poll loop (`$(seq 1 18)`) already relies on the same
+    opacity."""
+
+    def _armed(self, command, **kw):
+        helper = MainImplementationGuard()
+        return helper._run(tool="Bash", command=command,
+                           transcript_text=goal_armed_transcript(), **kw)
+
+    def _plain(self, command, **kw):
+        helper = MainImplementationGuard()
+        return helper._run(tool="Bash", command=command,
+                           transcript_text=transcript("claude-opus-4-8"),
+                           **kw)
+
+    def test_semicolon_hidden_reducer_inside_dollar_paren_allowed(self):
+        out = self._armed('echo "verzia: $(true; grep foo file)"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_and_and_hidden_reducer_inside_dollar_paren_allowed(self):
+        out = self._armed(
+            'echo "result: $(command -v jq && grep -rn foo .)"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_semicolon_hidden_reducer_inside_backticks_allowed(self):
+        out = self._armed('echo "verzia: `true; grep foo file`"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_real_health_check_shape_allowed_while_armed(self):
+        out = self._armed(
+            'echo "=== liveness ==="\n'
+            'for u in https://x/health https://y/health; do\n'
+            '  printf "%s -> %s\\n" "$u" "$(curl -s -o /dev/null '
+            '-w \'%{http_code}\' -m 15 "$u")"\n'
+            'done\n'
+            'echo "verzia: $(command -v jq && curl -s https://x/health '
+            '| grep -oP \'(?<=version: )[0-9.]+\')"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    # ---- genuine bulk reads OUTSIDE any substitution still block ----
+
+    def test_plain_bulk_read_not_hidden_in_substitution_still_blocked(self):
+        out = self._armed('grep -rn foo .; echo "$(true)"')
+        self.assertEqual(out.returncode, 2, out.stdout + out.stderr)
+
+    def test_not_armed_hidden_reducer_allowed_unchanged(self):
+        out = self._plain('echo "verzia: $(true; grep foo file)"')
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_subagent_hidden_reducer_never_blocked(self):
+        helper = MainImplementationGuard()
+        out = helper._run(tool="Bash",
+                          command='echo "verzia: $(true; grep foo file)"',
+                          agent_id="aWORKER5",
+                          transcript_text=goal_armed_transcript())
+        self.assertEqual(out.returncode, 0, out.stderr)
+
+
