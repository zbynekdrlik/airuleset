+# #88 (corpus replay of #80, 1/687): STATEMENTS_RE below splits on
+# `;`/`&`/`&&`/`||`/newline WITHOUT knowing about `$( ... )` / backtick
+# command-substitution boundaries. When the substitution's OWN inner text
+# contains one of those separators, the part after it — often a
+# `grep`/`awk`/`cat` reducer feeding a cheap one-line printf/echo, e.g.
+# `echo "verzia: $(command -v jq && grep -oP '...' f)"` — gets sliced off
+# and classified as a fresh TOP-LEVEL statement and blocked, even though the
+# whole visible output of the outer command is one short line. Fix: replace
+# the CONTENTS of every substitution span with an opaque, metacharacter-free
+# placeholder BEFORE segmentation — the same treatment heredoc BODIES
+# already get above. A substitution that genuinely dumps a bulk read back
+# into the outer command's own output (`X=$(cat bigfile)`) is deliberately
+# left unclassified: the corpus only ever showed this shape producing cheap
+# output (1/687), and the non-negotiable CI-poll loop (`$(seq 1 18)`)
+# already relies on the identical opacity.
+_PLACEHOLDER = "CMDSUB"
+
+
+def _find_matching_paren(text, start):
+    # `start` is the index right after the opening "(". Quote-aware,
+    # handles nested parens. Unterminated input fails safe to end-of-text
+    # (mirrors strip_heredocs' fallthrough for an unterminated delimiter).
+    depth = 1
+    i, n = start, len(text)
+    in_sq = in_dq = False
+    while i < n:
+        c = text[i]
+        if in_sq:
+            if c == "'":
+                in_sq = False
+            i += 1
+            continue
+        if in_dq:
+            if c == '\\' and i + 1 < n:
+                i += 2
+                continue
+            if c == '"':
+                in_dq = False
+            i += 1
+            continue
+        if c == "'":
+            in_sq = True
+        elif c == '"':
+            in_dq = True
+        elif c == '(':
+            depth += 1
+        elif c == ')':
+            depth -= 1
+            if depth == 0:
+                return i
+        i += 1
+    return n - 1
+
+
+def strip_command_substitutions(text):
+    out = []
+    i, n = 0, len(text)
+    in_sq = in_dq = False
+    while i < n:
+        c = text[i]
+        if in_sq:
+            out.append(c)
+            if c == "'":
+                in_sq = False
+            i += 1
+            continue
+        if c == "'" and not in_dq:
+            in_sq = True
+            out.append(c)
+            i += 1
+            continue
+        if in_dq and c == '\\' and i + 1 < n:
+            out.append(text[i:i + 2])
+            i += 2
+            continue
+        if c == '"':
+            in_dq = not in_dq
+            out.append(c)
+            i += 1
+            continue
+        if not in_sq and text[i:i + 2] == "$(":
+            j = _find_matching_paren(text, i + 2)
+            out.append("$(" + _PLACEHOLDER + ")")
+            i = j + 1
+            continue
+        if not in_sq and c == "`":
+            j = text.find("`", i + 1)
+            if j == -1:
+                out.append(c)
+                i += 1
+                continue
+            out.append("`" + _PLACEHOLDER + "`")
+            i = j + 1
+            continue
+        out.append(c)
+        i += 1
+    return "".join(out)
+
+
+cmd = strip_command_substitutions(cmd)
+
