+# #88: `$( … )` / `` ` … ` `` command substitutions are INVISIBLE to the
+# statement segmentation below, so a substitution whose own pipeline reducer
+# happens to land on its own line (an ordinary long `curl | grep` wrapping
+# style — 1/687 in the #80 gk replay) gets its reducer sliced off as its OWN
+# top-level statement and blocked, even though the substitution as a whole
+# is a cheap single-value read. Fix, mirroring `bash -c '...'`'s existing
+# recursion: mask each substitution span with a neutral placeholder BEFORE
+# segmentation (so its internal `;`/`|`/newline can never corrupt the OUTER
+# split), then recursively classify() the extracted inner text with the
+# SAME pipeline rules — a substitution hiding a genuine bulk read
+# (`X=$(cat bigfile)`) is still caught. Quote/backslash-aware, paren-depth
+# aware for nesting (`$(echo $(date))`); an unterminated span is left as-is
+# rather than crashing, same fallback style as strip_heredocs above.
+_CMDSUB_PLACEHOLDER = "AIRULESETCMDSUB%d"
+
+
+def mask_command_substitutions(text):
+    out = []
+    inner_scripts = []
+    i, n = 0, len(text)
+    in_sq = in_dq = False
+    while i < n:
+        c = text[i]
+        if in_sq:
+            out.append(c)
+            in_sq = c != "'"
+            i += 1
+            continue
+        if in_dq:
+            if c == '\\' and i + 1 < n:
+                out.append(text[i:i + 2])
+                i += 2
+                continue
+            out.append(c)
+            if c == '"':
+                in_dq = False
+            i += 1
+            continue
+        if c == "'":
+            in_sq = True
+            out.append(c)
+            i += 1
+            continue
+        if c == '"':
+            in_dq = True
+            out.append(c)
+            i += 1
+            continue
+        if c == '\\' and i + 1 < n:
+            out.append(text[i:i + 2])
+            i += 2
+            continue
+        if c == '$' and i + 1 < n and text[i + 1] == '(':
+            j = i + 2
+            depth = 1
+            isq = idq = False
+            while j < n and depth > 0:
+                cj = text[j]
+                if isq:
+                    isq = cj != "'"
+                elif idq:
+                    if cj == '\\' and j + 1 < n:
+                        j += 1
+                    elif cj == '"':
+                        idq = False
+                elif cj == "'":
+                    isq = True
+                elif cj == '"':
+                    idq = True
+                elif cj == '\\' and j + 1 < n:
+                    j += 1
+                elif cj == '(':
+                    depth += 1
+                elif cj == ')':
+                    depth -= 1
+                j += 1
+            if depth == 0:
+                inner_scripts.append(text[i + 2:j - 1])
+                out.append(_CMDSUB_PLACEHOLDER % (len(inner_scripts) - 1))
+                i = j
+                continue
+            out.append(c)          # unterminated — leave as-is
+            i += 1
+            continue
+        if c == '`':
+            j = i + 1
+            while j < n and text[j] != '`':
+                j += 2 if text[j] == '\\' and j + 1 < n else 1
+            if j < n:
+                inner_scripts.append(text[i + 1:j])
+                out.append(_CMDSUB_PLACEHOLDER % (len(inner_scripts) - 1))
+                i = j + 1
+                continue
+            out.append(c)          # unterminated — leave as-is
+            i += 1
+            continue
+        out.append(c)
+        i += 1
+    return "".join(out), inner_scripts
+
