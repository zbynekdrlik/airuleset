+# #88: a bare trailing `|` at the end of a raw split fragment is a PIPELINE
+# CONTINUING onto the next line, never a real statement boundary (that's
+# exactly how bash itself parses a pipe followed by a newline) — the
+# fragment after it is the reducer stage of the SAME pipeline, not a fresh
+# statement. `||` can never appear here since STATEMENTS_RE already consumes
+# it whole. Rejoin with a plain space; downstream tokenization treats
+# newlines and spaces identically anyway.
+def split_statements(text):
+    raw = STATEMENTS_RE.split(text)
+    merged = []
+    for seg in raw:
+        if merged and merged[-1].rstrip().endswith("|"):
+            merged[-1] = merged[-1].rstrip() + " " + seg.lstrip()
+        else:
+            merged.append(seg)
+    return merged
