+class CommandSubstitution88(unittest.TestCase):
+    """#88, found replaying gk's real commands under #80: the classifier
+    segments a command into statements (`;`/`&&`/`||`/`&`/newline) and
+    never looks INSIDE a `$( … )` (or backtick) command substitution first —
+    so a substitution whose own pipeline happens to break across a line
+    (a completely ordinary style for a long `curl | grep` health-check
+    one-liner) gets its reducer stage sliced off as its OWN top-level
+    statement and blocked, even though the substitution as a whole is a
+    cheap, single-value read. 1 of 687 real gk commands (0.15%) — rare, but
+    exactly the false-positive shape that killed #66 for 17 hours in #80.
+
+    Fix: mask `$( … )` / `` ` … ` `` spans before segmentation (so their
+    internal separators can never corrupt the OUTER statement split), then
+    classify each extracted span recursively with the SAME pipeline rules
+    (first-pipe-stage-only) the `bash -c '...'` branch already reuses — so
+    a substitution hiding a genuine bulk read is still blocked."""
+
+    def _armed(self, command, **kw):
+        helper = MainImplementationGuard()
+        return helper._run(tool="Bash", command=command,
+                           transcript_text=goal_armed_transcript(), **kw)
+
+    def test_reducer_inside_command_substitution_allowed(self):
+        # the pipe's reducer stage lands on its own LINE inside $( … ) — a
+        # completely ordinary long-curl-pipeline wrapping style.
+        out = self._armed(
+            "VERSION=$(curl -s https://erp.montalu.sk/web/health |\n"
+            "  grep -oP '(?<=\"version\": \")[0-9.]+')")
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_real_health_check_corpus_shape_allowed(self):
+        # the exact gk shape from #88's ticket: a liveness loop plus a
+        # trailing version extraction whose $( … ) wraps a curl|grep.
+        command = r"""echo "=== liveness ==="
+for u in https://erp.montalu.sk/web/health https://erp.montalu.sk/web/database/selector; do
+  printf "%s -> %s\n" "$u" "$(curl -s -o /dev/null -w '%{http_code}' -m 15 "$u")"
+done
+printf "version -> %s\n" "$(curl -s https://erp.montalu.sk/web/health |
+  grep -oP '(?<="version": ")[0-9.]+')"
+"""
+        out = self._armed(command)
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_backtick_reducer_split_across_lines_allowed(self):
+        out = self._armed(
+            "VERSION=`curl -s https://erp.montalu.sk/web/health |\n"
+            "  grep -oP '(?<=\"version\": \")[0-9.]+'`")
+        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
+
+    def test_bulk_read_inside_command_substitution_still_blocks(self):
+        # a genuine bulk read hidden inside $( … ) must still be caught —
+        # the fix must not turn command substitution into a blanket escape.
+        out = self._armed("X=$(cat models19.py)")
+        self.assertEqual(out.returncode, 2, out.stdout + out.stderr)
+
+    def test_bulk_read_inside_backtick_still_blocks(self):
+        out = self._armed("X=`cat models19.py`")
+        self.assertEqual(out.returncode, 2, out.stdout + out.stderr)
+
+    def test_bulk_read_as_the_first_stage_inside_substitution_still_blocks(self):
+        out = self._armed("X=$(grep -rn 'TODO' . | head -20)")
+        self.assertEqual(out.returncode, 2, out.stdout + out.stderr)
+
