#!/bin/bash
# bazos-usbdisk — root-owned helper for the USB disks the owner sells (#1394).
# Installed root:root 0755 at /usr/local/sbin/bazos-usbdisk; the bazos account
# may run it through one sudoers line. The disk is always named by its SERIAL,
# must be a whole disk on the usb transport, and is never a disk under /.
#
#   bazos-usbdisk list               usb disks + blkid of each partition
#   bazos-usbdisk info   SERIAL     SMART identity + health + blkid
#   bazos-usbdisk smart  SERIAL     full smartctl -a (read-only)
#   bazos-usbdisk readtest SERIAL   read the whole disk to /dev/null, count errors
#   bazos-usbdisk mount  SERIAL     every filesystem read-only under /mnt/bazos/SERIAL/
#   bazos-usbdisk umount SERIAL
#   bazos-usbdisk wipe   SERIAL LABEL   zero the whole disk, then one empty GPT/NTFS partition
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

LOG=/var/log/bazos-usbdisk.log
MNT=/mnt/bazos
SERIAL_RE='^[A-Za-z0-9_-]{4,40}$'
LABEL_RE='^[A-Za-z0-9_-]{1,32}$'

usage() {
    echo "usage: bazos-usbdisk list | info|smart|readtest|mount|umount SERIAL | wipe SERIAL LABEL" >&2
    exit 2
}

ACTION=${1:-}
case "$ACTION" in
    list) [ $# -eq 1 ] || usage ;;
    info|smart|readtest|mount|umount) [ $# -eq 2 ] || usage ;;
    wipe) [ $# -eq 3 ] || usage ;;
    *) usage ;;
esac
SERIAL=${2:-}
if [ "$ACTION" != list ] && ! [[ $SERIAL =~ $SERIAL_RE ]]; then
    echo "bazos-usbdisk: bad serial" >&2
    exit 2
fi
LABEL=${3:-}
if [ "$ACTION" = wipe ] && ! [[ $LABEL =~ $LABEL_RE ]]; then
    echo "bazos-usbdisk: bad label (A-Z a-z 0-9 _ -, max 32)" >&2
    exit 2
fi

[ "$(id -u)" -eq 0 ] || { echo "bazos-usbdisk: run it with sudo" >&2; exit 1; }

log() { printf '%s uid=%s %s\n' "$(date -Is)" "${SUDO_UID:-?}" "$*" >>"$LOG"; }
die() { echo "bazos-usbdisk: $*" >&2; log "$ACTION ${SERIAL:-} refused: $*"; exit 1; }

# Every whole disk under / (through partitions, LUKS, LVM, md), fail closed.
ROOT_SRC=$(findmnt -no SOURCE /)
mapfile -t ROOT_DISKS < <(lsblk -sno NAME,TYPE "$ROOT_SRC" |
    awk '$2 == "disk" {sub(/^[^[:alnum:]]+/, "", $1); print $1}')
[ "${#ROOT_DISKS[@]}" -gt 0 ] || die "cannot resolve the system disk"
is_root_disk() {
    local r
    for r in "${ROOT_DISKS[@]}"; do [ "$r" = "$1" ] && return 0; done
    return 1
}

# A real root-owned directory (never a symlink), created when missing.
safe_dir() {
    if [ -L "$1" ]; then die "$1 is a symlink"; fi
    if [ -e "$1" ]; then
        [ -d "$1" ] || die "$1 is not a directory"
        [ "$(stat -c '%u %a' "$1")" = "0 755" ] || die "$1 is not root:root 0755"
    else
        install -d -o root -g root -m 0755 "$1"
    fi
}

# Exactly one whole usb disk with this serial, else refuse.
disk_for() {
    local name
    mapfile -t name < <(lsblk -dnr -o NAME,TRAN,TYPE,SERIAL |
        awk -v s="$1" '$2 == "usb" && $3 == "disk" && $4 == s {print $1}')
    [ "${#name[@]}" -eq 1 ] || die "no single usb disk with serial $1 (${#name[@]} match)"
    if is_root_disk "${name[0]}"; then die "$1 is the system disk"; fi
    echo "${name[0]}"
}

# TYPE / PARTLABEL / LABEL of the disk and each partition (LDM, BitLocker, ...).
show_blkid() {
    local p t
    while read -r p t; do
        blkid -c /dev/null -s TYPE -s PARTLABEL -s LABEL "/dev/$p" ||
            echo "/dev/$p: no known signature"
    done < <(lsblk -nr -o NAME,TYPE "/dev/$1")
}

# smartctl ARGS on /dev/$D through the -d chain `info` uses. A type counts when
# smartctl opened the device and ran its commands (exit bits 0-2 clear); the
# higher bits describe the disk's health and are part of the answer.
smart_chain() {
    local t out rc
    for t in auto sat sntasmedia sntjmicron; do
        set +e
        if [ "$t" = auto ]; then
            out=$(smartctl "$@" "/dev/$D")
        else
            out=$(smartctl "$@" -d "$t" "/dev/$D")
        fi
        rc=$?
        set -e
        if [ $((rc & 7)) -eq 0 ]; then
            printf '%s\n' "$out"
            echo "(smartctl -d $t, exit $rc)"
            return 0
        fi
        echo "smartctl -d $t: exit $rc" >&2
    done
    printf '%s\n' "$out"
    return 1
}

case "$ACTION" in
list)
    lsblk -dnr -o NAME,TRAN,TYPE | awk '$2 == "usb" && $3 == "disk" {print $1}' |
        while read -r d; do
            if is_root_disk "$d"; then continue; fi
            lsblk -o NAME,SIZE,MODEL,SERIAL,TRAN,FSTYPE,LABEL,MOUNTPOINT "/dev/$d"
            show_blkid "$d"
        done
    ;;
info)
    D=$(disk_for "$SERIAL")
    log "info $SERIAL /dev/$D"
    smartctl -i -H "/dev/$D" || smartctl -i -H -d sat "/dev/$D" ||
        smartctl -i -H -d sntasmedia "/dev/$D" || smartctl -i -H -d sntjmicron "/dev/$D"
    show_blkid "$D"
    ;;
smart)
    D=$(disk_for "$SERIAL")
    log "smart $SERIAL /dev/$D"
    smart_chain -a || die "smartctl could not read $SERIAL with any -d type"
    ;;
readtest)
    D=$(disk_for "$SERIAL")
    # Reading never changes the disk, but a rw mount could change under the read.
    while read -r p _; do
        while read -r opts; do
            case ",$opts," in
                *,rw,*) die "/dev/$p is mounted read-write, run umount first" ;;
            esac
        done < <(findmnt -rn -S "/dev/$p" -o OPTIONS || true)
    done < <(lsblk -nr -o NAME,TYPE "/dev/$D")
    SIZE=$(blockdev --getsize64 "/dev/$D")
    log "readtest $SERIAL /dev/$D size=$SIZE start"
    DDERR=$(mktemp)
    trap 'rm -f "$DDERR"' EXIT
    T0=$(date +%s.%N)
    set +e
    # stdin closed: runs fine in the background; progress goes to stderr too.
    dd if=/dev/$D of=/dev/null bs=4M iflag=direct conv=noerror status=progress \
        </dev/null 2> >(tee "$DDERR" >&2)
    rc=$?
    wait $!
    set -e
    T1=$(date +%s.%N)
    BYTES=$(tr '\r' '\n' <"$DDERR" | awk '/^[0-9]+ bytes/ {b = $1} END {print b + 0}')
    ERRS=$(grep -c 'error reading' "$DDERR" || true)
    if KMSG=$(journalctl -k -o cat --no-pager --since "@${T0%.*}"); then
        KERR=$(printf '%s\n' "$KMSG" | grep -cE "(I/O|medium) error, dev $D," || true)
    else
        KERR=unknown
    fi
    SECS=$(awk -v a="$T0" -v b="$T1" 'BEGIN {printf "%.1f", b - a}')
    MBS=$(awk -v n="$BYTES" -v a="$T0" -v b="$T1" 'BEGIN {d = b - a; printf "%.1f", (d > 0 ? n / d / 1e6 : 0)}')
    if [ "$rc" -ne 0 ] || [ "$ERRS" -ne 0 ] || { [ "$KERR" != unknown ] && [ "$KERR" -ne 0 ]; }; then
        RESULT=ERRORS
    elif [ "$BYTES" -ne "$SIZE" ]; then
        RESULT=INCOMPLETE
    else
        RESULT=OK
    fi
    SUMMARY="bytes=$BYTES size=$SIZE seconds=$SECS MB/s=$MBS dd_read_errors=$ERRS kernel_io_errors=$KERR dd_rc=$rc result=$RESULT"
    log "readtest $SERIAL /dev/$D $SUMMARY"
    echo "readtest $SERIAL /dev/$D $SUMMARY"
    [ "$RESULT" = OK ] || exit 1
    ;;
mount)
    D=$(disk_for "$SERIAL")
    BAZOS_UID=$(id -u bazos)
    BAZOS_GID=$(id -g bazos)
    log "mount $SERIAL /dev/$D"
    safe_dir "$MNT"
    safe_dir "$MNT/$SERIAL"
    n=0
    # The disk line too: a filesystem on the whole disk (no partition table).
    while read -r part fstype; do
        [ -n "$fstype" ] || continue
        case "$fstype" in
            ntfs) t=ntfs3; extra=",uid=$BAZOS_UID,gid=$BAZOS_GID,umask=022" ;;
            vfat|exfat) t=$fstype; extra=",uid=$BAZOS_UID,gid=$BAZOS_GID,umask=022" ;;
            ext2|ext3|ext4) t=ext4; extra=",noload" ;;
            *) echo "skip /dev/$part: filesystem $fstype is not on the allow-list"; continue ;;
        esac
        dir="$MNT/$SERIAL/$part"
        if [ -L "$dir" ]; then die "$dir is a symlink"; fi
        # A mounted dir shows the filesystem's owner; check the dir only when free.
        if findmnt -rn --mountpoint "$dir" >/dev/null; then n=$((n + 1)); continue; fi
        safe_dir "$dir"
        mount -t "$t" -o "ro,nosuid,nodev,noexec$extra" "/dev/$part" "$dir" ||
            die "mount /dev/$part ($fstype) failed"
        echo "mounted /dev/$part ($fstype) at $dir"
        n=$((n + 1))
    done < <(lsblk -nr -o NAME,FSTYPE "/dev/$D")
    [ "$n" -gt 0 ] || die "nothing mountable on $SERIAL"
    ;;
umount)
    D=$(disk_for "$SERIAL")
    log "umount $SERIAL /dev/$D"
    if [ -e "$MNT/$SERIAL" ]; then
        safe_dir "$MNT"
        safe_dir "$MNT/$SERIAL"
        for dir in "$MNT/$SERIAL"/*; do
            [ -e "$dir" ] || [ -L "$dir" ] || continue
            if [ -L "$dir" ]; then die "$dir is a symlink"; fi
            if findmnt -rn --mountpoint "$dir" >/dev/null; then umount -- "$dir"; fi
            safe_dir "$dir"
            rmdir -- "$dir"
        done
        rmdir -- "$MNT/$SERIAL"
    fi
    sync
    echo "unmounted $SERIAL"
    ;;
wipe)
    D=$(disk_for "$SERIAL")
    if lsblk -nr -o MOUNTPOINT "/dev/$D" | grep -q .; then die "$SERIAL is mounted, run umount first"; fi
    for h in /sys/block/"$D"/holders/* /sys/block/"$D"/"$D"*/holders/*; do
        if [ -e "$h" ]; then die "$SERIAL is in use by $(basename "$h")"; fi
    done
    log "wipe $SERIAL /dev/$D label=$LABEL start"
    wipefs -a "/dev/$D" >/dev/null
    DDERR=$(mktemp)
    trap 'rm -f "$DDERR"' EXIT
    set +e
    dd if=/dev/zero of="/dev/$D" bs=4M oflag=direct status=progress 2>"$DDERR"
    rc=$?
    set -e
    tail -c 2000 "$DDERR" >>"$LOG"
    # dd ends with rc 1 + ENOSPC when it reaches the end of the disk.
    [ "$rc" -eq 1 ] && grep -q "No space left on device" "$DDERR" || die "dd failed rc=$rc"
    sync
    parted -s "/dev/$D" mklabel gpt mkpart primary ntfs 1MiB 100%
    partprobe "/dev/$D"
    udevadm settle
    mapfile -t parts < <(lsblk -nr -o NAME,TYPE "/dev/$D" | awk '$2 == "part" {print $1}')
    [ "${#parts[@]}" -eq 1 ] || die "expected one new partition, found ${#parts[@]}"
    mkfs.ntfs -Q -L "$LABEL" "/dev/${parts[0]}" >>"$LOG" 2>&1
    log "wipe $SERIAL done: zeroed, GPT + NTFS $LABEL"
    echo "wiped $SERIAL: zeroed, one empty NTFS partition labelled $LABEL"
    ;;
esac
