# airuleset web terminal — ttyd gateway (systemd --user unit, managed by airuleset).
#
# Installed ONLY on dev1 (the single gateway that holds every fleet ssh identity)
# by `airuleset.py install` via setup_webterm_service() — unlike the File-Drop
# unit, which runs on every box. ExecStart runs the generated launcher script
# ({{LAUNCH_SCRIPT}} is substituted with the absolute path at install time); the
# launcher execs ttyd bound LOOPBACK-only (127.0.0.1:7682) behind a `-b /t` base
# path (#584). ttyd carries NO basic-auth of its own now — the same-origin
# gateway (webterm-gateway.service) is the sole tailnet entry AND authenticator
# (form login + session cookie), and a tailnet peer cannot reach this loopback
# ttyd around it. (Was #579: bound to dev1's tailscale IP with `ttyd -c`
# basic-auth, whose native dialog a password manager could not fill.)
#
# Deliberately LIGHT hardening: this service spawns interactive ssh + tmux child
# processes (it needs ~/.ssh, ~/.secrets, AF_UNIX for ssh-agent/control sockets),
# so the filedrop unit's ProtectSystem=strict / RestrictAddressFamilies would
# break it. The security boundary is the LOOPBACK bind (unreachable from the
# tailnet) + the same-origin gateway's form login in front of it (#584), not a
# service sandbox.
#
# Do not edit the installed copy in ~/.config/systemd/user/ by hand — edit this
# template and re-run `python3 airuleset.py install`.

[Unit]
Description=airuleset web terminal — ttyd fleet gateway (dev1-only)
Documentation=https://github.com/zbynekdrlik/airuleset
After=network-online.target
Wants=network-online.target
# Restart loop guard: more than StartLimitBurst restarts in the interval = stop.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/env bash {{LAUNCH_SCRIPT}}
Restart=on-failure
RestartSec=5
# ttyd forks one child (ssh + remote tmux) per connected client — ~20 sessions
# open at once is the design target; keep the caps generous.
MemoryMax=512M
TasksMax=512

[Install]
WantedBy=default.target
