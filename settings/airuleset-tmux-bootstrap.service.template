# airuleset tmux bootstrap — systemd --user oneshot (managed by airuleset).
#
# #961: on shared-stream / gk / controller boxes, ensure the stream's ONE tmux
# session exists in the correct project cwd BEFORE any webterm tab attaches.
# Without this, a reboot followed by a webterm connect creates the session in
# $HOME (the forced command's `new-session -A` fallback), and the user cannot
# launch claude in the right project context.
#
# Runs the existing #263 bootstrap (ensure_stream_tmux_session) as a oneshot
# at boot (linger is on for all managed accounts). Idempotent: never touches
# an existing session.
#
# Do not edit the installed copy in ~/.config/systemd/user/ by hand — edit this
# template and re-run `python3 airuleset.py install`.

[Unit]
Description=airuleset tmux bootstrap — create stream tmux session at boot
Documentation=https://github.com/zbynekdrlik/airuleset
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/bin/env python3 {{REPO_DIR}}/airuleset.py stream-tmux-bootstrap
# Generous timeout — tmux bootstrap is fast but python import can be slow
# on a cold start.
TimeoutStartSec=60

[Install]
WantedBy=default.target
