{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/session-start-fetch.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-vault-store-read.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-sensitive-staging.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-gh-invalid-json-flag.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-history-rewrite.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-foreign-airuleset-write.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-push-lint.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-push-test-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-test-skips.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-ungated-issue-filing.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-gk-request-without-selfservice.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-handoff-without-composer.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-deploy-clean-tree.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-push-base-sync.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-tier0-local-build.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-destructive-remote.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-broad-pkill.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-root-recursive-grep.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-heavy-build-toolchain.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-discuss-archive.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-unscoped-tmux-kill.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-fork-no-merge-issue-close.sh"
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-subagent-bg-ci-poll.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-subdev-ssh-misuse.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-main-implementation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-ci-poll-repeat.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-local-poll-repeat.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/nudge-poll-loop-timeout.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-commit-without-design.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-worker-close-trigger.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-discuss-thread-name.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/inject-situational-rule.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-vault-store-read.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-vault-store-read.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-vault-store-read.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-ask-auto-answer.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/inject-situational-rule.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-agent-validate-subagent-type.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-unpinned-model-dispatch.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-main-implementation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-dispatch-over-wdrain.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/inject-situational-rule.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-vault-store-read.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-write-script-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-main-implementation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-discuss-thread-name.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/inject-situational-rule.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-vault-store-read.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/pre-write-script-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-main-implementation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-discuss-thread-name.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/inject-situational-rule.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-foreign-airuleset-write.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-main-implementation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-dispatch-over-wdrain.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-main-implementation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/block-unpinned-model-dispatch.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__win-.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/inject-situational-rule.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/post-push-ci-cleanup.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/post-record-subagent-bg-launch.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/post-record-design-comment.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/post-record-subagent-bg-launch.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/post-record-subagent-bg-launch.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/post-consume-main-exec-marker.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-ci.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-prose-violations.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-untracked-work.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-status-marker.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-working-liveness.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-question-quality.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-playbook-review.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-prod-gating.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/stop-check-sendmessage-narration.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/notify-discord-pending.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/notify-compact-request.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/notify-api-error.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/notify-discord.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/clear-question-dedup.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/inject-situational-rule.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/subagent-stop-check-bg-work.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/subagent-stop-check-run-card.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/subagent-stop-check-design.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/subagent-stop-check-lane-return.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/notify-compact-subagent-boundary.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/devel/airuleset/hooks/subagent-stop-check-review-tier.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
